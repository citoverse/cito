# Rtools ships pkg-config and the three libraries; querying it keeps us correct when CRAN's
# recipes add a transitive dependency (libtiff already pulls lerc)
PKG_CONFIG = pkg-config
PKG_CPPFLAGS = -DHAVE_JPEG -DHAVE_PNG -DHAVE_TIFF $(shell $(PKG_CONFIG) --cflags libtiff-4 libjpeg libpng)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(shell $(PKG_CONFIG) --libs libtiff-4 libjpeg libpng) $(SHLIB_OPENMP_CXXFLAGS)
