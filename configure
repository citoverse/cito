#!/bin/sh
# cito: the compiled image decoder is optional. If a library is missing the package still
# builds and falls back to the R readers, so a missing -dev package must never fail the install.
: "${R_HOME=$(R RHOME)}"
PKGCONFIG=$(command -v pkg-config 2>/dev/null)

CPPFLAGS=""
LIBS=""

try_lib () {   # $1 pkg-config name, $2 macro, $3 fallback -l flag, $4 header
  if [ -n "$PKGCONFIG" ] && $PKGCONFIG --exists "$1" 2>/dev/null; then
    CPPFLAGS="$CPPFLAGS $($PKGCONFIG --cflags "$1") -D$2"
    LIBS="$LIBS $($PKGCONFIG --libs "$1")"
    echo "cito: found $1 via pkg-config"
    return 0
  fi
  for d in /usr/include /usr/local/include /usr/include/$(uname -m)-linux-gnu \
           /opt/homebrew/include /opt/R/arm64/include /opt/R/x86_64/include; do
    [ -f "$d/$4" ] || continue
    # a header without its library is the failure that only shows up as a link error later,
    # so this compiles and links a probe rather than trusting the header's presence
    if echo "#include <$4>
int main(void){return 0;}" | "${CC:-cc}" -I"$d" -x c - $3 -o /dev/null 2>/dev/null; then
      CPPFLAGS="$CPPFLAGS -I$d -D$2"
      LIBS="$LIBS $3"
      echo "cito: found $4 in $d"
      return 0
    fi
  done
  echo "cito: $1 not found, that format will use the R fallback reader"
  return 1
}

try_lib libjpeg   HAVE_JPEG -ljpeg jpeglib.h
try_lib libpng    HAVE_PNG  -lpng  png.h
try_lib libtiff-4 HAVE_TIFF -ltiff tiffio.h

sed -e "s|@CITO_CPPFLAGS@|$CPPFLAGS|" -e "s|@CITO_LIBS@|$LIBS|" src/Makevars.in > src/Makevars
echo "cito: PKG_CPPFLAGS =$CPPFLAGS"
echo "cito: PKG_LIBS =$LIBS"
exit 0
